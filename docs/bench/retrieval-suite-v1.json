{
  "evalFormatVersion": "2026-04",
  "name": "registry-retrieval-v1",
  "description": "Golden retrieval queries for this repository: exported symbols, paths, and natural-language questions over the maintained docs. A case passes when one of its expected targets appears in the top three results.",
  "tags": [
    "retrieval",
    "registry",
    "deterministic"
  ],
  "cases": [
    {
      "id": "question-add-agent",
      "input": "How do I add a validated agent with npx agentskit add?",
      "expected": {
        "regex": {
          "body": "docs/getting-started\\.md"
        }
      },
      "metadata": {
        "expectedTargets": [
          "docs/getting-started.md"
        ],
        "lang": "en",
        "kind": "question"
      }
    },
    {
      "id": "question-contribute-files",
      "input": "What files must an agent include before a pull request?",
      "expected": {
        "regex": {
          "body": "docs/contributing\\.md|CONTRIBUTING\\.md"
        }
      },
      "metadata": {
        "expectedTargets": [
          "docs/contributing.md",
          "CONTRIBUTING.md"
        ],
        "lang": "en",
        "kind": "question"
      }
    },
    {
      "id": "question-build-flow",
